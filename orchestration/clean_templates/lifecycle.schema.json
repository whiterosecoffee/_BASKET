{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "synthetic",
    "role",
    "task",
    "request",
    "session",
    "ownership",
    "input",
    "acknowledgment",
    "outcome",
    "recovery",
    "schedule",
    "privacy"
  ],
  "properties": {
    "schema": {
      "const": "basket.lifecycle_snapshot@0.1-draft"
    },
    "synthetic": {
      "const": true
    },
    "role": {
      "enum": [
        "fetch_owner",
        "data_consumer",
        "clean_consumer"
      ]
    },
    "task": {
      "type": "object"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "deadline",
        "input_revision",
        "branch",
        "source_revision",
        "operation",
        "planned_writes"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "input_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "operation": {
          "enum": [
            "consume",
            "refresh"
          ]
        },
        "planned_writes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "session_id",
        "conversation_id",
        "conversation_open",
        "nathan_can_communicate",
        "dot_can_communicate",
        "expected_host",
        "observed_host",
        "executor_verified",
        "verification_receipt",
        "worktree_isolated",
        "connected"
      ],
      "properties": {
        "discovery": {
          "const": "resume_existing"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_open": {
          "const": true
        },
        "nathan_can_communicate": {
          "const": true
        },
        "dot_can_communicate": {
          "const": true
        },
        "expected_host": {
          "const": "MELISSA"
        },
        "observed_host": {
          "const": "MELISSA"
        },
        "executor_verified": {
          "const": true
        },
        "verification_receipt": {
          "$ref": "#/$defs/artifact_ref"
        },
        "worktree_isolated": {
          "const": true
        },
        "connected": {
          "const": true
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_verified",
        "active_writers"
      ],
      "properties": {
        "inventory_verified": {
          "const": true
        },
        "active_writers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "qualification",
        "qualified_until",
        "local",
        "access",
        "provider_owner",
        "acquisition_owner",
        "persistence_owner",
        "repair_owner",
        "refresh_owner"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "qualification": {
          "const": "qualified"
        },
        "qualified_until": {
          "type": "string",
          "format": "date-time"
        },
        "local": {
          "const": true
        },
        "access": {
          "enum": [
            "read_only",
            "owner_managed"
          ]
        },
        "provider_owner": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_owner": {
          "const": "_FETCH"
        },
        "persistence_owner": {
          "const": "_FETCH"
        },
        "repair_owner": {
          "const": "_FETCH"
        },
        "refresh_owner": {
          "const": "_FETCH"
        }
      }
    },
    "acknowledgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "request_sha256",
        "session_id"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "run_observed",
        "receipt",
        "effect_state",
        "consumer_acceptance",
        "acceptance_receipt"
      ],
      "properties": {
        "state": {
          "enum": [
            "completed",
            "failed",
            "parked"
          ]
        },
        "run_observed": {
          "type": "boolean"
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "request_sha256"
          ],
          "properties": {
            "artifact": {
              "$ref": "#/$defs/artifact_ref"
            },
            "request_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "effect_state": {
          "enum": [
            "none",
            "reconciled_no_change"
          ]
        },
        "consumer_acceptance": {
          "enum": [
            "pending",
            "rejected",
            "accepted"
          ]
        },
        "acceptance_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_failures",
        "checkpoint",
        "uncertain_write_policy",
        "next_action",
        "replay_policy"
      ],
      "properties": {
        "prior_failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkpoint": {
          "$ref": "#/$defs/artifact_ref"
        },
        "uncertain_write_policy": {
          "const": "inspect_effect_and_readback_before_retry"
        },
        "next_action": {
          "enum": [
            "review_existing_receipt",
            "park_and_route_to_owner",
            "resume_after_reconciliation"
          ]
        },
        "replay_policy": {
          "const": "same_key_reconcile_no_reapply"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured",
        "configuration_is_run"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "configuration_is_run": {
          "const": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_class",
        "publish_input",
        "publication_scope",
        "private_paths_in_public_receipt"
      ],
      "properties": {
        "input_class": {
          "enum": [
            "private",
            "synthetic"
          ]
        },
        "publish_input": {
          "type": "boolean"
        },
        "publication_scope": {
          "const": "sanitized_code_tests_docs_only"
        },
        "private_paths_in_public_receipt": {
          "const": false
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Proposed synthetic checkpoint shape only. Shared artifact_ref is bound from component-blackbox.v1.json by lifecycle.validate; no remote refs resolved."
}
