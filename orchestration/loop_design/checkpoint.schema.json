{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local loop-design checkpoint, no storage implementation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "run_id",
    "input_digest",
    "source_revision",
    "owner",
    "action_key",
    "expected_target_revision",
    "next_action",
    "scope",
    "fence",
    "attempt",
    "stage",
    "receipt"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "action_key": {
      "type": "string",
      "minLength": 1
    },
    "expected_target_revision": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fence": {
      "type": "integer",
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "enum": [
        "observed",
        "proposed",
        "prepared",
        "effect_uncertain",
        "effect_confirmed",
        "reviewed",
        "accepted",
        "blocked",
        "no_op"
      ]
    },
    "receipt": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "effect_confirmed",
              "reviewed",
              "accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ]
}
