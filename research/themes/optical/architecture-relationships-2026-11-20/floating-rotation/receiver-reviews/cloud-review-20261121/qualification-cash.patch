+import copy
+import importlib.util
+import json
+import os
+import unittest
+from decimal import Decimal as D
+from pathlib import Path
+import rotation
+
+REFERENCE = Path(os.environ['ROTATION_REFERENCE_ROOT'])
+EXAMPLE = json.loads((REFERENCE/'example.json').read_text())
+
+def qualified():
+    d = copy.deepcopy(EXAMPLE)
+    tickers = {d['held'], *d['alternatives']}
+    d['qualification'] = dict(as_of=d['paired_quotes'][1]['at'],
+        quote_ttd_seconds=60, max_quote_skew_seconds=2,
+        instruments={t:dict(currency='USD', instrument_id=t,
+            share_basis='synthetic common', earnings_basis='recurring-adjusted') for t in tickers},
+        endpoints={str(c['years']):c['end'] for c in d['alternatives']['NVDA']})
+    for q in d['paired_quotes']:
+        q.update(source='synthetic', session='regular', observed_at={t:q['at'] for t in tickers})
+    for cases in d['alternatives'].values():
+        for c in cases:
+            c.update(held_basis='recurring-adjusted', candidate_basis='recurring-adjusted')
+    return d
+
+class CandidateChecks(unittest.TestCase):
+    def test_valid_metadata(self):
+        self.assertTrue(rotation.analyze(qualified())['NVDA']['metadata_qualified'])
+
+    def test_legacy_fields_unchanged(self):
+        spec=importlib.util.spec_from_file_location('original',REFERENCE/'rotation.py')
+        original=importlib.util.module_from_spec(spec);spec.loader.exec_module(original)
+        old=original.analyze(EXAMPLE);new=rotation.analyze(EXAMPLE)
+        for ticker, value in old.items():
+            self.assertFalse(new[ticker]['metadata_qualified'])
+            for key,v in value.items():
+                if key=='scenarios':
+                    for a,b in zip(v,new[ticker][key]):
+                        for field,x in a.items():self.assertEqual(x,b[field])
+                else:self.assertEqual(v,new[ticker][key])
+
+    def test_bad_metadata_rejected(self):
+        def stale(d): d['qualification']['as_of']='2026-11-21T00:00:00Z'
+        def skew(d): d['paired_quotes'][1]['observed_at']['NVDA']='2026-11-20T13:14:50-07:00'
+        def old_constituent(d): d['paired_quotes'][1]['observed_at']['NVDA']='2026-11-20T13:10:00-07:00'
+        def future(d): d['paired_quotes'][1]['observed_at']['NVDA']='2026-11-20T13:16:00-07:00'
+        def basis(d): d['alternatives']['NVDA'][0]['held_basis']='GAAP'
+        def endpoint(d): d['alternatives']['CRWV'][2]['end']='2035-11-20'
+        def fx(d): d['qualification']['instruments']['NVDA']['currency']='KRW'
+        def missing(d): del d['paired_quotes'][1]['source']
+        def policy(d): d['qualification']['quote_ttd_seconds']='NaN'
+        def lookahead(d): d['alternatives']['NVDA'][0]['available_at']='2030-01-01T00:00:00Z'
+        def session(d): d['paired_quotes'][1]['session']='afterhours'
+        for change in [stale,skew,old_constituent,future,basis,endpoint,fx,missing,policy,lookahead,session]:
+            with self.subTest(case=change.__name__):
+                d=qualified();change(d)
+                with self.assertRaises(ValueError):rotation.analyze(d)
+
