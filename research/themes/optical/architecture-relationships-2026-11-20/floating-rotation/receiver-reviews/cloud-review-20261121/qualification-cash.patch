+def qualify(data):
+    """Validate supplied point-in-time metadata; no provider/account verification."""
+    if "qualification" not in data:
+        return False
+    try:
+        config = data["qualification"]
+        as_of = instant(config["as_of"])
+        ttd = number(config["quote_ttd_seconds"])
+        skew = number(config["max_quote_skew_seconds"])
+        if ttd <= 0 or skew < 0:
+            raise ValueError("invalid freshness policy")
+        tickers = {data["held"], *data["alternatives"]}
+        instruments = config["instruments"]
+        for ticker in tickers:
+            meta = instruments[ticker]
+            if (meta["currency"] != "USD" or not meta["instrument_id"]
+                    or not meta["share_basis"] or not meta["earnings_basis"]):
+                raise ValueError("USD instrument and earnings basis required")
+        snapshots = data["paired_quotes"]
+        if len(snapshots) != 2 or snapshots[0]["session"] != snapshots[1]["session"]:
+            raise ValueError("matching sessions required")
+        for index, snapshot in enumerate(snapshots):
+            at = instant(snapshot["at"])
+            if not snapshot["source"] or at > as_of:
+                raise ValueError("missing quote source or future snapshot")
+            times = [instant(snapshot["observed_at"][t]) for t in tickers]
+            if any(t > at or number((at-t).total_seconds()) > ttd for t in times):
+                raise ValueError("stale or future constituent quote")
+            if number((max(times)-min(times)).total_seconds()) > skew:
+                raise ValueError("asynchronous quotes")
+            if index == 1 and number((as_of-at).total_seconds()) > ttd:
+                raise ValueError("expired current snapshot")
+        current = instant(snapshots[1]["at"])
+        endpoints = config["endpoints"]
+        for candidate, cases in data["alternatives"].items():
+            for case in cases:
+                years = case["years"]
+                end = date.fromisoformat(case["end"])
+                if (type(years) is not int or years not in (1, 2, 3)
+                        or endpoints[str(years)] != case["end"]
+                        or end.year != current.year + years):
+                    raise ValueError("inconsistent calendar endpoint")
+                held_basis = instruments[data["held"]]["earnings_basis"]
+                candidate_basis = instruments[candidate]["earnings_basis"]
+                if (case["held_basis"] != held_basis
+                        or case["candidate_basis"] != candidate_basis
+                        or held_basis != candidate_basis):
+                    raise ValueError("mixed earnings bases")
+    except (KeyError, TypeError, IndexError) as exc:
+        raise ValueError("incomplete qualification metadata") from exc
+    return True
+
