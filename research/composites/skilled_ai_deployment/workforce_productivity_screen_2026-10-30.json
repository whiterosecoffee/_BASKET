    "headcount_yoy_pct": "100*(current/previous_year-1)",
    "revenue_per_employee_annualized": "4*quarterly_USD_revenue/end_period_employee_count",
    "productivity_yoy_pct": "100*((1+revenue_growth_yoy_pct/100)/(1+headcount_growth_yoy_pct/100)-1)",
    "gross_profit_per_employee": "quarterly_revenue*reported_GAAP_gross_margin/average_FTE (pending normalized inputs)"
  },
