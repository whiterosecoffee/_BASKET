  "weighting_policy": {
    "cadence": "monthly and on material filed earnings; checkpoints snapshot and research replay",
    "initial": "eligible securities only; do not allocate on unverified price or EPS",
    "signal_components": {
      "expected_2027_2028_total_return": 0.35,
      "downside_and_valuation_risk": 0.2,
      "recurring_product_profit_conversion": 0.2,
      "earnings_quality_and_cash_flow": 0.15,
      "diversification_liquidity_execution": 0.1
    },
    "guardrails": {
      "max_single_ticker_weight_pct": 15,
      "max_issuer_group_weight_pct": 20,
      "max_segment_weight_pct": 35,
      "min_full_liquidity_and_quotes": true,
      "max_annual_turnover_target_pct": 100,
      "not_an_optimization_result": true
    },
    "rebalance_method": "Freeze eligibility, reports and price/FX as known at rebalance cutoff; exclude stale; compute price and return scenarios; rank; cap; renormalize; apply costs and trade constraints; persist alternatives and triggers.",
    "performance_accounting": "Frozen holdings, dividends, splits, FX, transaction costs, slippage; separate price-return and total-return vs benchmarks",
    "no_double_counting": "Classify issuer by primary revenue economics; overlapping downstream end-market demand factors constrained across sleeves"
  },
  "rubric_pe_ranges_hypothesis": [
    {
      "class": "slow_labor_services",
      "forward_pe": [
        8,
        13
      ],
      "criteria": "organic growth <=5%, no margin acceleration, low intellectual property/recurring income"
    },
    {
      "class": "profitable_repeatable_services",
      "forward_pe": [
        12,
        18
      ],
      "criteria": "organic growth 5-10%, positive FCF and stable operating margin >=12%, client retention and diversification"
    },
    {
      "class": "fast_growing_ai_integration",
      "forward_pe": [
        16,
        24
      ],
      "criteria": "organic growth 10-20%, EPS/FCF growth 15%+, operating margins >=15% or credible expansion, balanced concentration"
    },
    {
      "class": "platformized_vertical_agent_operations",
      "forward_pe": [
        20,
        30
      ],
      "criteria": "recurring revenue >30%, organic growth 15%+, repeat implementations, gross profit/FTE growing, GAAP/FCF corroborate"
    },
    {
      "class": "durable_embedded_ai_software",
      "forward_pe": [
        25,
        40
      ],
      "criteria": "growth 20%+, retention >110%, software gross margin >65%, substantial recurring licenses, FCF positive, low concentration"
    }
  ],
  "multiple_application_rule": "Do not assign top range from AI branding, total contract value, adjusted margin alone; use equivalent earnings basis; if GAAP earnings negative use EV/FCF or EV/GP with explicit capital structure not fictitious PE.",
