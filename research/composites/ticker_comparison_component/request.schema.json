{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows",
    "cutoff",
    "evaluated_at",
    "windows",
    "correlation_window",
    "source"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "NVDA",
          "CRWV",
          "SMH",
          "QQQ"
        ],
        "properties": {
          "t": {
            "type": "integer",
            "minimum": 0
          },
          "NVDA": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "CRWV": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "SMH": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "QQQ": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        }
      },
      "minItems": 1
    },
    "cutoff": {
      "type": "string",
      "format": "date"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "correlation_window": {
      "type": "integer",
      "minimum": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "entitlement",
        "currency",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "synthetic",
            "captured"
          ]
        },
        "entitlement": {
          "enum": [
            "authorized",
            "not_required"
          ]
        },
        "currency": {
          "const": "USD"
        },
        "basis": {
          "const": "split_adjusted_price_return_not_total_return"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "captured"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "entitlement": {
                "const": "authorized"
              }
            }
          }
        }
      }
    }
  ]
}
