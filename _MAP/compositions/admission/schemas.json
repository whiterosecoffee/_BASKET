{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "value",
        "observed_at",
        "as_of",
        "semantics",
        "available_at"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "semantics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "available_at": {
          "type": "string",
          "format": "date-time",
          "description": "First externally available time for this exact source revision, not event/observation time or local ingestion time. Required; unknown availability fails closed."
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "violations"
      ],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "value",
            "observed_at",
            "as_of",
            "semantics",
            "available_at"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "number"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "semantics": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "available_at": {
              "type": "string",
              "format": "date-time",
              "description": "First externally available time for this exact source revision, not event/observation time or local ingestion time. Required; unknown availability fails closed."
            }
          }
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "status",
        "value",
        "reasons"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "reasons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
