{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whiterosecoffee/_BASKET/blob/work/136-worker-execution-bridge/architecture/contracts/handoff-request.schema.json",
  "title": "Proposed cross-lane handoff request; not a worker claim or execution authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "origin_issue",
    "origin_revision",
    "receiver_lane",
    "objective",
    "target_paths",
    "input_artifact",
    "expected_output_contract",
    "preconditions",
    "acceptance",
    "dependencies",
    "resource_estimate",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "basket.handoff_request.proposal@1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_issue": {
      "type": "string",
      "format": "uri"
    },
    "origin_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "receiver_lane": {
      "type": "string",
      "pattern": "^L[0-9]{2}$"
    },
    "objective": {
      "type": "string",
      "minLength": 12
    },
    "target_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "input_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "expected_output_contract": {
      "$ref": "#/$defs/artifact"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "evidence_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 8
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "resource_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_range",
        "confidence",
        "additional_resources_required"
      ],
      "properties": {
        "token_range": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "additional_resources_required": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "status": {
      "const": "requested"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
