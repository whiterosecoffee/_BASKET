{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "_BASKET task queue plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "queue_version",
    "as_of",
    "active_worker_limit",
    "tasks"
  ],
  "properties": {
    "schema": {
      "const": "basket.task_queue@1"
    },
    "queue_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "active_worker_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "spark_id",
          "title",
          "objective",
          "priority",
          "impact",
          "effort",
          "mode",
          "profiles",
          "recipe",
          "capabilities",
          "depends_on",
          "acceptance",
          "write_scope",
          "issue_number",
          "pr_number"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]{3}$"
          },
          "spark_id": {
            "type": "string",
            "pattern": "^B[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 6
          },
          "objective": {
            "type": "string",
            "minLength": 12
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "mode": {
            "enum": [
              "orchestrator_review",
              "resume_existing_worker",
              "launch_new_worker"
            ]
          },
          "recipe": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "gate"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "pattern": "^T-[0-9]{3}$"
                },
                "gate": {
                  "enum": [
                    "merged",
                    "ci_passed_on_head",
                    "issue_exists"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issue_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "pr_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_handoff_issues": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "block_note": {
            "type": "string"
          },
          "worker_prompt_details": {
            "type": "string"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    }
  }
}
