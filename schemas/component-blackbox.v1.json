{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whiterosecoffee/_BASKET/blob/main/schemas/component-blackbox.v1.json",
  "title": "basket.component_contract@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component_id",
    "owner_spark",
    "version",
    "determinism",
    "inputs",
    "outputs",
    "errors",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "const": "basket.component_contract@1"
    },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "owner_spark": {
      "type": "string",
      "pattern": "^B[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "determinism": {
      "enum": [
        "pure",
        "snapshot_replay",
        "external_observation"
      ]
    },
    "inputs": {
      "$ref": "#/$defs/ports"
    },
    "outputs": {
      "$ref": "#/$defs/ports"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "version_range"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "version_range": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "test_command",
        "minimum_tests",
        "fixtures",
        "ci_owner"
      ],
      "properties": {
        "test_command": {
          "type": "string",
          "minLength": 1
        },
        "minimum_tests": {
          "type": "integer",
          "minimum": 1
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ci_owner": {
          "const": "B01"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "schema_ref",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "freshness_policy": {
            "enum": [
              "immutable",
              "point_in_time",
              "ttl",
              "not_applicable"
            ]
          },
          "source_class": {
            "enum": [
              "verified_observation",
              "company_statement",
              "inference",
              "scenario",
              "unknown_or_conflicted",
              "mixed"
            ]
          }
        }
      }
    }
  }
}
