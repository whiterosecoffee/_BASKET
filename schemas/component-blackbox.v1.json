{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whiterosecoffee/_BASKET/blob/main/schemas/component-blackbox.v1.json",
  "title": "basket.component_contract@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component_id",
    "owner_spark",
    "version",
    "determinism",
    "inputs",
    "outputs",
    "errors",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "const": "basket.component_contract@1"
    },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "owner_spark": {
      "type": "string",
      "pattern": "^B[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "determinism": {
      "enum": [
        "pure",
        "snapshot_replay",
        "external_observation"
      ]
    },
    "inputs": {
      "$ref": "#/$defs/ports"
    },
    "outputs": {
      "$ref": "#/$defs/ports"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "version_range"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "version_range": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "test_command",
        "minimum_tests",
        "fixtures",
        "ci_owner"
      ],
      "properties": {
        "test_command": {
          "type": "string",
          "minLength": 1
        },
        "minimum_tests": {
          "type": "integer",
          "minimum": 1
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ci_owner": {
          "const": "B01"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "boundary_profile": {
      "const": "qualified_refs_v1"
    },
    "assumptions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "guarantees": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effects": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "schema_ref",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "freshness_policy": {
            "enum": [
              "immutable",
              "point_in_time",
              "ttl",
              "not_applicable"
            ]
          },
          "source_class": {
            "enum": [
              "verified_observation",
              "company_statement",
              "inference",
              "scenario",
              "unknown_or_conflicted",
              "mixed"
            ]
          },
          "schema_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "artifact",
        "record_type",
        "subject_id",
        "observed_at",
        "available_at",
        "ingested_at",
        "effective_at",
        "published_at",
        "period",
        "session",
        "unit",
        "currency",
        "freshness",
        "entitlement",
        "supersedes"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "record_type": {
          "enum": [
            "quote",
            "aggregate_bar",
            "trade",
            "options_flow",
            "issuer_fact",
            "holdings",
            "estimate",
            "macro_release",
            "expectation",
            "scenario",
            "model_output",
            "other"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "available_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "ingested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "effective_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "session": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PRE",
            "RTH",
            "AH",
            "closed",
            "not_applicable",
            null
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "freshness": {
          "enum": [
            "qualified",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "entitlement": {
          "enum": [
            "authorized",
            "not_required",
            "not_entitled",
            "unknown"
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "freshness": {
                "const": "qualified"
              }
            },
            "required": [
              "freshness"
            ]
          },
          "then": {
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
              },
              "available_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          }
        }
      ]
    },
    "port_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_sha256",
        "artifact",
        "sources"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_evidence"
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/port_binding"
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "component_id",
        "contract_version",
        "run_id",
        "as_of",
        "inputs",
        "method",
        "options"
      ],
      "properties": {
        "contract": {
          "const": "basket.component_call@1"
        },
        "component_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "inputs": {
          "allOf": [
            {
              "$ref": "#/$defs/bindings"
            }
          ],
          "minProperties": 1
        },
        "method": {
          "$ref": "#/$defs/artifact_ref"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offline",
            "seed"
          ],
          "properties": {
            "offline": {
              "type": "boolean"
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "missing_inputs",
        "conflicts",
        "warnings"
      ],
      "properties": {
        "freshness": {
          "enum": [
            "qualified",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "missing_inputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "component_id",
        "contract_version",
        "run_id",
        "as_of",
        "status",
        "outputs",
        "provenance",
        "quality",
        "error"
      ],
      "properties": {
        "contract": {
          "const": "basket.component_result@1"
        },
        "component_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "insufficient_evidence"
          ]
        },
        "outputs": {
          "$ref": "#/$defs/bindings"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_sha256",
            "method",
            "code_sha",
            "generated_at"
          ],
          "properties": {
            "input_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "method": {
              "$ref": "#/$defs/artifact_ref"
            },
            "code_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
            }
          }
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outputs": {
                "minProperties": 1,
                "additionalProperties": {
                  "properties": {
                    "sources": {
                      "items": {
                        "properties": {
                          "freshness": {
                            "enum": [
                              "qualified",
                              "not_applicable"
                            ]
                          },
                          "entitlement": {
                            "enum": [
                              "authorized",
                              "not_required"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "quality": {
                "properties": {
                  "freshness": {
                    "enum": [
                      "qualified",
                      "not_applicable"
                    ]
                  },
                  "missing_inputs": {
                    "maxItems": 0
                  },
                  "conflicts": {
                    "maxItems": 0
                  }
                }
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "error",
                  "insufficient_evidence"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outputs": {
                "maxProperties": 0
              },
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Backward-compatible manifest plus opt-in qualified boundary definitions. Schema validation establishes shape only; reference resolution, hashes, units, source truth and temporal ordering require semantic acceptance.",
  "allOf": [
    {
      "if": {
        "required": [
          "boundary_profile"
        ]
      },
      "then": {
        "required": [
          "assumptions",
          "guarantees",
          "effects"
        ],
        "properties": {
          "inputs": {
            "items": {
              "required": [
                "schema_sha256",
                "freshness_policy",
                "source_class"
              ]
            }
          },
          "outputs": {
            "items": {
              "required": [
                "schema_sha256",
                "freshness_policy",
                "source_class"
              ]
            }
          }
        }
      }
    }
  ]
}
