{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whiterosecoffee/_BASKET/blob/main/schemas/worker-resolution.v1.json",
  "title": "_BASKET worker resolution payload v1",
  "description": "Worker assertions are not independently verified until B00 compares GitHub issue/PR/CI evidence. Incomplete work is reported honestly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "spark_id",
    "issue",
    "branch",
    "pr",
    "reported_at",
    "disposition",
    "changed_paths",
    "checks",
    "acceptance",
    "blockers",
    "handoffs",
    "unknowns",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "basket.worker_resolution@1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^B[0-9]{2}-[1-9][0-9]*$"
    },
    "spark_id": {
      "type": "string",
      "pattern": "^B[0-9]{2}$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/whiterosecoffee/_BASKET/issues/[1-9][0-9]*$"
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "base"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^work/[1-9][0-9]*-[a-z0-9][a-z0-9-]*$"
        },
        "base": {
          "const": "main"
        }
      }
    },
    "pr": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number",
            "url",
            "head_sha",
            "state",
            "draft",
            "merged"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/whiterosecoffee/_BASKET/pull/[1-9][0-9]*$"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "state": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "draft": {
              "type": "boolean"
            },
            "merged": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "reported_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Null when the worker report time is not independently established."
    },
    "disposition": {
      "enum": [
        "in_progress",
        "component_verified",
        "ready_for_integration",
        "integration_blocked",
        "integrated",
        "blocked",
        "withdrawn"
      ]
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "result",
          "execution",
          "evidence_urls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "unit",
              "integration",
              "schema",
              "workflow",
              "snapshot",
              "manual_review",
              "source_verification"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "skipped",
              "not_run"
            ]
          },
          "execution": {
            "enum": [
              "ci",
              "local",
              "github_review",
              "not_executed"
            ]
          },
          "evidence_urls": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "evidence_urls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A[0-9]+$"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_verified"
            ]
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "blocking"
        ],
        "properties": {
          "kind": {
            "enum": [
              "issue",
              "pr",
              "ci",
              "source",
              "provider",
              "schema",
              "integration",
              "other"
            ]
          },
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "pr_number": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 4
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_number",
          "target_spark",
          "state"
        ],
        "properties": {
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "target_spark": {
            "type": "string",
            "pattern": "^B[0-9]{2}$"
          },
          "state": {
            "enum": [
              "requested",
              "claimed",
              "accepted",
              "completed",
              "superseded"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "class",
          "status",
          "source_urls"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 8
          },
          "class": {
            "enum": [
              "source_fact",
              "issuer_statement",
              "third_party_claim",
              "inference",
              "scenario",
              "unknown"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "provisional",
              "disputed",
              "unverified"
            ]
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "effective_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "available_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 8
    },
    "report_classification": {
      "const": "self_report_unverified_until_b00_evidence_check"
    },
    "task_queue_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^T-[0-9]{3}$",
      "description": "Planner task identifier, separate from worker's issue-scoped task_id."
    }
  }
}
