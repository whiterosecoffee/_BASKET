{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whiterosecoffee/_BASKET/blob/main/schemas/worker-task.v1.json",
  "title": "_BASKET worker task v1",
  "description": "Proposed immutable task claim payload in worker GitHub issue. Issue/branch actual existence must be verified by B00.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "spark_id",
    "issue",
    "branch",
    "objective",
    "write_paths",
    "acceptance",
    "dependencies",
    "claimed_at",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "basket.worker_task@1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^B[0-9]{2}-[1-9][0-9]*$"
    },
    "spark_id": {
      "type": "string",
      "pattern": "^B[0-9]{2}$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/whiterosecoffee/_BASKET/(issues|pull)/[1-9][0-9]*$"
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "base"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^work/[1-9][0-9]*-[a-z0-9][a-z0-9-]*$"
        },
        "base": {
          "const": "main"
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 12,
      "maxLength": 3000
    },
    "write_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "read_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "evidence_class"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A[0-9]+$"
          },
          "criterion": {
            "type": "string",
            "minLength": 8
          },
          "evidence_class": {
            "enum": [
              "ci",
              "test",
              "source",
              "code_review",
              "replay",
              "documentation"
            ]
          },
          "mandatory": {
            "type": "boolean"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_number",
          "kind",
          "blocks_completion"
        ],
        "properties": {
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "handoff",
              "upstream_pr",
              "schema",
              "source",
              "review",
              "external_provider"
            ]
          },
          "blocks_completion": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "claimed",
        "building",
        "review",
        "blocked",
        "integrated",
        "closed"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}
